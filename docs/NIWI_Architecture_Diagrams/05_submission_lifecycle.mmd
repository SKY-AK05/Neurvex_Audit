flowchart TD
    Start["Respondent Starts Assessment at /audit"] --> AutoSave["Autosave Draft after 2s Inactivity"]
    AutoSave --> FormCompleted["Respondent Completes All Questions (Q1-Q44)"]
    
    subgraph SynchronousIngestion["Synchronous Ingestion Phase (<25ms)"]
        FormCompleted --> SubmitReq["POST /api/submit with Idempotency-Key"]
        SubmitReq --> FastValidation["Fast Validation of Schema and Organization"]
        FastValidation --> DBWrite["Atomic DB Transaction:<br/>Insert raw_submissions<br/>Insert service_bus_outbox (status: staged)<br/>Mark draft_submissions as submitted"]
        DBWrite --> ReturnAccepted["Return HTTP 202 Accepted with submission_id"]
    end

    subgraph AsynchronousWorker["Asynchronous Background Processing"]
        ReturnAccepted --> OutboxPoll["Worker Claims Record via SELECT FOR UPDATE SKIP LOCKED"]
        OutboxPoll --> ScoringEngine["Deterministic 8-Pillar Scoring Engine"]
        ScoringEngine --> WriteFinalDB["Insert Permanent Record into submissions and org_submission_links"]
        WriteFinalDB --> SendEmail["Render Responsive HTML and Send via Azure ACS"]
        SendEmail --> SyncCRM["Sync Lead and Organization Data to HubSpot CRM"]
        SyncCRM --> MarkProcessed["Mark service_bus_outbox as processed"]
    end

    MarkProcessed --> Complete["Submission Lifecycle Successfully Completed"]
